# Copy to `.dev.vars` (gitignored) for `wrangler dev` + drizzle-kit + seed scripts.
# Production values are Worker secrets: `wrangler secret put <NAME>`.

# Neon Postgres connection string for the MANAGER's own database
# (not a tenant DB, not the sibling manttio-whitelabeled DB).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# HS256 signing secret for auth JWTs (any long random string in dev).
JWT_SECRET=change-me

# Password for `pnpm seed:admin <email> [name]` — only read by the seed script.
SEEDED_ADMIN_PASSWORD=change-me

# Resend API key for outbound billing/setup emails. A bogus value is fine if you
# aren't testing email — sends fail and are logged, everything else still works.
RESEND_API_KEY=re_change_me

# Shared instance-push token (any long random string in dev — instances aren't
# reachable from dev anyway). Prod value is a Worker secret, rotated daily.
SHARED_INSTANCE_TOKEN=change-me
